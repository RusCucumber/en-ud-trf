[
    {
        "label": "Pytest: Run All Tests",
        "command": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN -m pytest",
        "allow_concurrent_runs": true,
        "tags": ["Python"],
    },
    {
        "label": "Pytest: Run Current Target",
        "command": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN -m pytest \"$ZED_CUSTOM_PYTHON_TEST_TARGET\"",
        "use_new_terminal": true,
        "tags": ["Python"],
    },
    {
        "label": "Pytest: Debug Current Target (--pdb)",
        "command": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN -m pytest \"$ZED_CUSTOM_PYTHON_TEST_TARGET\" --pdb",
        "use_new_terminal": true,
        "tags": ["Python"],
    },
    {
        "label": "Marimo: Edit Current File",
        "command": "uv run marimo",
        "args": ["edit", "$ZED_FILE"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["marimo", "Python"],
    },
    {
        "label": "Marimo: Run Current File",
        "command": "uv run marimo",
        "args": ["run", "$ZED_FILE"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["marimo", "Python"],
    },
    {
        "label": "R Terminal (radian)",
        "command": "./run_radian.sh",
        "args": ["--no-save", "--no-restore"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["r-repl"],
    },
    {
        "label": "Quarto: Preview Current File",
        "command": "quarto",
        "args": ["preview", "$ZED_FILE"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["Quarto"],
    },
    {
        "label": "Quarto: New R Notebook from Template",
        "command": "./notebooks/R/template/new_r_notebook.sh",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["Quarto"],
    },
    {
        "label": "Quarto: Render Current File",
        "command": "quarto",
        "args": ["render", "$ZED_FILE", "--cache-refresh"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": true,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "hide": "never",
        "tags": ["Quarto"],
    },
]
