[
    {
        "label": "Pytest: Run All Tests",
        "command": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN -m pytest",
        "allow_concurrent_runs": true,
        "tags": ["Python"],
    },
    {
        "label": "Pytest: Run Current Target",
        "command": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN -m pytest \"$ZED_CUSTOM_PYTHON_TEST_TARGET\"",
        "use_new_terminal": true,
        "tags": ["Python"],
    },
    {
        "label": "Pytest: Debug Current Target (--pdb)",
        "command": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN -m pytest \"$ZED_CUSTOM_PYTHON_TEST_TARGET\" --pdb",
        "use_new_terminal": true,
        "tags": ["Python"],
    },
]
