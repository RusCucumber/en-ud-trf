{
    "format_on_save": "on",
    "tab_size": 4,
    "hard_tabs": false,
    "show_whitespaces": "all",
    "languages": {
        "Python": {
            "format_on_save": "on",
            "tab_size": 4,
            "language_servers": ["ty", "ruff"],
            "code_actions_on_format": {
                "source.organizeImports.ruff": true,
                "source.fixAll": true,
            },
            "formatter": {
                "language_server": {
                    "name": "ruff",
                },
            },
        },
        "TOML": {
            "language_servers": ["tombi"],
        },
        "Plain Text": {
            "soft_wrap": "none",
        },
        "CSV": {
            "soft_wrap": "none",
        },
    },
    "lsp": {
        "ruff": {
            "settings": {
                "organizeImports": true,
                "configuration": "${workspaceFolder}/pyproject.toml",
            },
        },
        "ty": {
            "settings": {
                "diagnosticMode": "workspace",
                "completions": {
                    "autoImport": true,
                    "completeFunctionParentheses": true,
                },
            },
        },
    },
    // Load .envrc via `direnv export json` so language servers, tasks and the terminal
    // see the same environment variables (requires direnv + `direnv allow`)
    "load_direnv": "direct",
    "terminal": {
        "detect_venv": "off",
    },
    "wrap_guides": [119],
}
