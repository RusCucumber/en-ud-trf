{
    "env": {
        "GIT_CONFIG_COUNT": "4",
        "GIT_CONFIG_KEY_0": "url.https://github.com/.insteadOf",
        "GIT_CONFIG_VALUE_0": "git@github.com:",
        "GIT_CONFIG_KEY_1": "url.https://github.com/.insteadOf",
        "GIT_CONFIG_VALUE_1": "ssh://git@github.com/",
        "GIT_CONFIG_KEY_2": "credential.https://github.com.helper",
        "GIT_CONFIG_VALUE_2": "",
        "GIT_CONFIG_KEY_3": "credential.https://github.com.helper",
        "GIT_CONFIG_VALUE_3": "!gh auth git-credential"
    },
    "permissions": {
        "allow": [
            "// Local git operations",
            "Bash(git status)",
            "Bash(git diff)",
            "Bash(git log)",
            "Bash(git show)",
            "Bash(git branch)",
            "Bash(git checkout)",
            "Bash(git fetch)",
            "Bash(git pull)",
            "Bash(git push)",
            "Bash(git stash)",
            "Bash(git tag)",
            "Bash(git add)",
            "Bash(git commit)",
            "// Python dependency management with uv",
            "Bash(uv sync)",
            "Bash(uv add)",
            "Bash(uv remove)",
            "Bash(uv run ruff check)",
            "Bash(uv run ruff format)",
            "Bash(uv run pytest)",
            "Bash(uv run ty check)",
            "// Directory/file exploration (read-only)",
            "Bash(ls)",
            "Bash(find)",
            "Bash(pwd)",
            "Bash(tree)",
            "Bash(fd)",
            "// Safe text viewing",
            "Bash(grep)",
            "Bash(ripgrep)",
            "Bash(rg)",
            "Bash(wc)",
            "Bash(file)",
            "Bash(stat)",
            "// Skills pre-approval (reduces permission friction)",
            "Skill(python-environment)",
            "Skill(python-code-quality)",
            "Skill(pytest-in-uv)",
            "Skill(git-strategy)",
            "Skill(notebook-workflows)"
        ],
        "deny": [
            "Read(.env)",
            "Read(*.env)",
            "Read(.env.*)",
            "Read(**/.env)",
            "Read(**/*.env)",
            "Read(**/.env.*)",
            "Read(.envrc)",
            "Read(**/.envrc)",
            "Read(secrets/**)",
            "Read(./*.pem)",
            "Read(./*.key)",
            "Read(src/**/*.pem)",
            "Read(src/**/*.key)",
            "Read(assets/**/*.pem)",
            "Read(assets/**/*.key)",
            "Read(corpus/**/*.pem)",
            "Read(corpus/**/*.key)",
            "Read(notebooks/**/*.pem)",
            "Read(notebooks/**/*.key)",
            "Read(metrics/**/*.pem)",
            "Read(metrics/**/*.key)",
            "Read(docs/**/*.pem)",
            "Read(docs/**/*.key)",
            "Read(.github/**/*.pem)",
            "Read(.github/**/*.key)",
            "Read(configs/**/*.pem)",
            "Read(configs/**/*.key)",
            "Read(scripts/**/*.pem)",
            "Read(scripts/**/*.key)",
            "Read(training/**/*.pem)",
            "Read(training/**/*.key)",
            "Read(packages/**/*.pem)",
            "Read(packages/**/*.key)",
            "Read(~/.ssh/**)",
            "Edit(secrets/**)",
            "Edit(./*.pem)",
            "Edit(./*.key)",
            "Edit(src/**/*.pem)",
            "Edit(src/**/*.key)",
            "Edit(assets/**/*.pem)",
            "Edit(assets/**/*.key)",
            "Edit(corpus/**/*.pem)",
            "Edit(corpus/**/*.key)",
            "Edit(notebooks/**/*.pem)",
            "Edit(notebooks/**/*.key)",
            "Edit(metrics/**/*.pem)",
            "Edit(metrics/**/*.key)",
            "Edit(docs/**/*.pem)",
            "Edit(docs/**/*.key)",
            "Edit(.github/**/*.pem)",
            "Edit(.github/**/*.key)",
            "Edit(configs/**/*.pem)",
            "Edit(configs/**/*.key)",
            "Edit(scripts/**/*.pem)",
            "Edit(scripts/**/*.key)",
            "Edit(training/**/*.pem)",
            "Edit(training/**/*.key)",
            "Edit(packages/**/*.pem)",
            "Edit(packages/**/*.key)",
            "Edit(~/.ssh/**)",
            "Bash(cat *.env*)",
            "Bash(head *.env*)",
            "Bash(tail *.env*)",
            "Bash(less *.env*)",
            "Bash(more *.env*)",
            "Bash(grep *.env*)",
            "Bash(sed *.env*)",
            "Bash(awk *.env*)",
            "Bash(vim *.env*)",
            "Bash(nano *.env*)",
            "Bash(bat *.env*)",
            "Bash(open *.env*)",
            "Edit(.env*)",
            "Edit(**/.env*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "input=$(cat); file=$(echo \"$input\" | jq -r '.tool_input.file_path // empty'); if [[ \"$file\" == *.py ]]; then uv run ruff check --fix \"$file\"; uv run ruff format \"$file\"; fi; exit 0"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ \"$(uname -s)\" = \"Darwin\" ] && command -v afplay >/dev/null 2>&1; then afplay /System/Library/Sounds/Glass.aiff; fi; exit 0"
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {
        "genshijin@genshijin": true,
        "oh-my-claudecode@omc": true,
        "claude-mem@thedotmack": true,
        "superpowers@anthropic-plugin-directory": true
    },
    "sandbox": {
        "enabled": true,
        "autoAllowBashIfSandboxed": true,
        "allowUnsandboxedCommands": false,
        "network": {
            "allowedDomains": [
                "github.com",
                "*.github.com",
                "objects.githubusercontent.com",
                "raw.githubusercontent.com",
                "registry.npmjs.org",
                "api.anthropic.com",
                "api.github.com",
                "*.vercel.com",
                "*.supabase.co",
                "pypi.org",
                "files.pythonhosted.org",
                "localhost",
                "127.0.0.1",
                "huggingface.co",
                "*.huggingface.co",
                "cdn-lfs.huggingface.co",
                "cdn-lfs-us-1.huggingface.co",
                "*.hf.co",
                "chatgpt.com",
                "*.chatgpt.com",
                "*.openai.com"
            ],
            "allowLocalBinding": true,
            "allowMachLookup": ["com.apple.trustd.agent"]
        },
        "filesystem": {
            "allowWrite": [
                "~/.cache/uv",
                "~/.claude/.omc",
                "~/.claude/plugins/oh-my-claudecode",
                "~/.claude/plugins/cache/omc",
                "~/.cache/huggingface",
                "~/.codex",
                "~/.claude-mem"
            ],
            "denyRead": [
                "**/.env*",
                "*.pem",
                "*.key",
                "src/**/*.pem",
                "src/**/*.key",
                "assets/**/*.pem",
                "assets/**/*.key",
                "corpus/**/*.pem",
                "corpus/**/*.key",
                "notebooks/**/*.pem",
                "notebooks/**/*.key",
                "metrics/**/*.pem",
                "metrics/**/*.key",
                "docs/**/*.pem",
                "docs/**/*.key",
                ".github/**/*.pem",
                ".github/**/*.key",
                "configs/**/*.pem",
                "configs/**/*.key",
                "scripts/**/*.pem",
                "scripts/**/*.key",
                "training/**/*.pem",
                "training/**/*.key",
                "secrets/**",
                "~/.ssh/**"
            ],
            "allowRead": ["~/.claude"]
        }
    }
}
